  "statutes": [
    {
      "id": "law-22-23",
      "code": "Law 22-23",
      "title": "Auto-Entrepreneur statutory regime",
      "keywords": [
        "auto-entrepreneur",
        "regime",
        "status",
        "law",
        "eligib",
        "register",
        "anae"
      ],
      "summary": "Defines the Auto-Entrepreneur status, its annual turnover ceiling and the flat-rate tax treatment of registered activities."
    },
    {
      "id": "ceiling",
      "code": "Law 22-23 · Ceiling",
      "title": "Annual turnover ceiling",
      "keywords": [
        "ceiling",
        "threshold",
        "limit",
        "maximum",
        "exceed",
        "5,000,000",
        "5m",
        "turnover"
      ],
      "summary": "Collected turnover is capped at 5,000,000 DZD per fiscal year. The ceiling is measured on cash actually received, not on invoices issued."
    },
    {
      "id": "cash-basis",
      "code": "Law 22-23 · Cash basis",
      "title": "Cash-basis turnover recognition",
      "keywords": [
        "cash",
        "collected",
        "paid",
        "payment",
        "receipt",
        "recognition",
        "pending",
        "realization"
      ],
      "summary": "An invoice counts toward the ceiling only once the payment is credited. Pending and draft invoices do not consume ceiling capacity."
    },
    {
      "id": "vat-exemption",
      "code": "Decree 23-197 · VAT",
      "title": "0% VAT exemption clause",
      "keywords": [
        "vat",
        "tva",
        "exempt",
        "exemption",
        "clause",
        "withholding",
        "tax"
      ],
      "summary": "Invoices must carry the statutory exemption clause so that B2B clients do not apply withholding taxes."
    },
    {
