# Environment variables template for MoukawilOS Docker Compose environment

# PostgreSQL with pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=moukawilos
DATABASE_URL=postgresql://postgres:postgres@db:5432/moukawilos

# Backend API
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
RAG_SERVICE_URL=http://rag:8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# RAG Microservice
RAG_HOST=0.0.0.0
RAG_PORT=8000
OPENAI_API_KEY=
